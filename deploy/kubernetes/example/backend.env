# The backend's settings (ConfigMap penelope-backend-env; docs/backend.md
# "設定"). Every value here is made up: replace them (README.md, "Values to
# replace"). The places of the files are fixed by the base.
PENELOPE_PUBLIC_URL=https://penelope.example.com
# The GitHub OAuth App (its callback is <PENELOPE_PUBLIC_URL>/auth/github/callback)
# and the owner's numeric GitHub user ID. The client secret is in the Secret penelope-backend.
PENELOPE_GITHUB_CLIENT_ID=example-client-id
PENELOPE_OWNER_GITHUB_ID=12345678
PENELOPE_TIME_ZONE=Asia/Tokyo
# The avatar copied into /memory/avatar/ the first time (README.md, "Avatar").
# PENELOPE_AVATARS_DIR is set by patches/statefulset.yaml.
PENELOPE_AVATAR=example
# The name shown in the UI, over the name in /memory/avatar/avatar.json.
PENELOPE_AGENT_NAME=Example
# Slack's events are drawn into the turn (docs/events.md). Writing this replaces
# the default, so job is included explicitly.
PENELOPE_INLINE_SOURCES=job,slack
# A heartbeat after this many quiet minutes while the agent is awake.
PENELOPE_HEARTBEAT_MINUTES=30
