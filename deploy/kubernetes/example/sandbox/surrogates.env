# The surrogates and endpoints of the sandbox (ConfigMap penelope-sandbox-env).
# None is a real key: the Sentinel puts the real one in their place for the host
# it is registered with (sentinel/sentinel.yaml). Each surrogate is also written
# there; make your own (README.md, "Surrogates").
PENELOPE_BACKEND_TOKEN=surrogate-example-backend-0001
# Slack's bot token, for slackctl post and curl to slack.com (connectors/slack.md).
SLACK_BOT_TOKEN=surrogate-example-slack-0001
# Stable Diffusion WebUI, for sdctl (connectors/sd-webui.md).
SDCTL_URL=https://sd-webui.example.com
SDCTL_TOKEN=surrogate-example-sd-webui-0001
# X search through llm-proxy in xAI mode (connectors/x-search.md).
X_SEARCH_URL=https://llm-proxy-xai.example.com
X_SEARCH_TOKEN=surrogate-example-x-search-0001
# An A2A agent (connectors/agents.md).
HELPER_AGENT_TOKEN=surrogate-example-helper-agent-0001
