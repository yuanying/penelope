{
  "name": "@penelope/house",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "penelope-source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --conditions=penelope-source --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@penelope/contract": "*",
    "@penelope/github-oauth": "*",
    "@penelope/service-account-auth": "*"
  }
}
